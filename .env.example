# ReplayPoker API (public, no auth needed - used as fallback)
VITE_REPLAY_API_BASE=https://www.casino.org/replaypoker

# Google Sheets ID (the long ID from your spreadsheet URL)
# e.g., from https://docs.google.com/spreadsheets/d/ABC123.../edit
VITE_SHEETS_ID=your_spreadsheet_id_here

# Google AppScript Proxy URL (REQUIRED for CORS bypass)
# Deploy appscript/Code.gs as a web app and paste the URL here
# Without this, API calls will fail due to browser CORS restrictions
VITE_APPSCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Polling interval (ms)
VITE_POLLING_INTERVAL=30000
